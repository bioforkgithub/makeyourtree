#NEXUS
[ a synthetic file written for the MakeYourTree test suite ]
BEGIN TAXA;
    DIMENSIONS NTAX=4;
    TAXLABELS Alpha Beta 'Gamma delta' Epsilon_zeta;
END;
BEGIN TREES;
    TRANSLATE
        1 Alpha,
        2 Beta,
        3 'Gamma delta',
        4 Epsilon_zeta
        ;
    TREE first = [&R] ((1:0.1,2:0.2):0.3,(3:0.4,4:0.5):0.6);
    TREE * second = [&R] ((1,3),(2,4));
END;
